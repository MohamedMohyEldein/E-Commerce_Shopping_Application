<mxfile host="app.diagrams.net">
  <diagram id="erd" name="ERD">
    <mxGraphModel>
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Category -->
        <mxCell id="cat" value="Category\n- Id\n- Name\n- Description" style="shape=rectangle;whiteSpace=wrap;rounded=1;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="160" height="100" as="geometry"/>
        </mxCell>

        <!-- Product -->
        <mxCell id="prod" value="Product\n- Id\n- Name\n- Description\n- Price\n- CategoryId" style="shape=rectangle;whiteSpace=wrap;rounded=1;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="260" y="40" width="200" height="120" as="geometry"/>
        </mxCell>

        <!-- ProductVariant -->
        <mxCell id="variant" value="ProductVariant\n- Id\n- Color\n- Size\n- Stock\n- ProductId" style="shape=rectangle;whiteSpace=wrap;rounded=1;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="520" y="40" width="200" height="120" as="geometry"/>
        </mxCell>

        <!-- Cart -->
        <mxCell id="cart" value="Cart\n- Id\n- UserId" style="shape=rectangle;whiteSpace=wrap;rounded=1;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="220" width="160" height="80" as="geometry"/>
        </mxCell>

        <!-- CartItem -->
        <mxCell id="cartItem" value="CartItem\n- Id\n- Quantity\n- CartId\n- ProductVariantId" style="shape=rectangle;whiteSpace=wrap;rounded=1;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="260" y="220" width="220" height="120" as="geometry"/>
        </mxCell>

        <!-- Wishlist -->
        <mxCell id="wishlist" value="Wishlist\n- Id\n- UserId" style="shape=rectangle;whiteSpace=wrap;rounded=1;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="380" width="160" height="80" as="geometry"/>
        </mxCell>

        <!-- WishlistItem -->
        <mxCell id="wishlistItem" value="WishlistItem\n- Id\n- WishlistId\n- ProductId" style="shape=rectangle;whiteSpace=wrap;rounded=1;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="260" y="380" width="200" height="100" as="geometry"/>
        </mxCell>

        <!-- Order -->
        <mxCell id="order" value="Order\n- Id\n- UserId\n- OrderDate\n- Status\n- TotalAmount" style="shape=rectangle;whiteSpace=wrap;rounded=1;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="520" y="220" width="220" height="140" as="geometry"/>
        </mxCell>

        <!-- OrderItem -->
        <mxCell id="orderItem" value="OrderItem\n- Id\n- OrderId\n- ProductVariantId\n- Quantity\n- UnitPrice" style="shape=rectangle;whiteSpace=wrap;rounded=1;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="520" y="380" width="240" height="140" as="geometry"/>
        </mxCell>

        <!-- Relations -->
        <mxCell id="cat_prod" edge="1" parent="1" source="cat" target="prod">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="prod_variant" edge="1" parent="1" source="prod" target="variant">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="cart_cartitems" edge="1" parent="1" source="cart" target="cartItem">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="cartitem_variant" edge="1" parent="1" source="cartItem" target="variant">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="wishlist_items" edge="1" parent="1" source="wishlist" target="wishlistItem">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="wishlistitem_product" edge="1" parent="1" source="wishlistItem" target="prod">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="order_orderitems" edge="1" parent="1" source="order" target="orderItem">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="orderitem_variant" edge="1" parent="1" source="orderItem" target="variant">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
